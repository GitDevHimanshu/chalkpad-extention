{
  "manifest_version": 3,
  "name": "Chalkpad Attendance Helper",
  "version": "2.0",
  "description": "Automatically mark attendance on Chalkpad. Supports multi-period, absentee marking, and Google Sheets formula generation.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://csoethp.codebrigade.in/*",
    "https://chalkpad-attendance.onrender.com/*",
    "https://cuiet.codebrigade.in/*",
    "https://docs.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "style.css",
        "template.js",
        "sheetSync.js"
      ],
      "matches": [
        "https://csoethp.codebrigade.in/*",
        "https://cuiet.codebrigade.in/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://csoethp.codebrigade.in/*",
        "https://cuiet.codebrigade.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content-styles.css"
      ]
    }
  ]
}